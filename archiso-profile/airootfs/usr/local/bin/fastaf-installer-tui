#!/usr/bin/env bash

# ==================================================
# ==========             INIT             ==========
# ==================================================

# Ensure script is run as root
if [ "$EUID" -ne 0 ]; then
    echo "[-] Something went wrong - launch script wasn't ran as root | Please make an issue on the Github"
    exit 1
fi

# Global state variables
FASTAF_LOG="/var/log/fastaf-installer-tui.log"
FASTAF_KEYMAP=""
FASTAF_LOCALE=""
FASTAF_TARGET_DRIVE=""
FASTAF_HOSTNAME="fast-af"
FASTAF_USER_NAME="dev"
FASTAF_USER_PASSWORD=""
FASTAF_ROOT_PASSWORD=""
# Dotfiles repo method is deprecated - going to make a meta package. This variable will just be renamed dotfiles package once we can setup for it
FASTAF_DOTFILES_REPO="https://github.com/something/something/dotfiles.git"
FASTAF_ENCRYPT=false
FASTAF_ENCRYPT_PASSWORD=""
FASTAF_ENCRYPT_FIDO=false
FASTAF_DOAS_FIDO=false

# Ensure system log directory exists
mkdir -p /var/log
# Logging
log_info() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$FASTAF_LOG"
}
fatal_error() {
    local error_msg="$1"
    log_info "FATAL ERROR: $error_msg"

    # Show a dialog box before dying, if the TUI is still functional/running
    if command -v dialog &>/dev/null; then
        dialog --title "Fatal Error" --msgbox "A critical error occurred:\n\n$error_msg\n\nThe installer must abort." 10 60
    fi

    clear
    echo "[-] FATAL ERROR: $error_msg"
    echo "[-] Check the log file for details: $FASTAF_LOG"
    exit 1
}

log_info "Fast-AF Installer TUI initialized. Active log: $FASTAF_LOG"

# ==================================================
# ==========        DIALOG WRAPPER        ==========
# ==================================================
# Intercepts every call to 'dialog' and automatically applies the file descriptor routing so command substitution works.
dialog() {
    command dialog "$@" 3>&1 1>&2 2>&3
}

# ==================================================
# ==========        GATEWAY PROMPT        ==========
# ==================================================

configure_gateway() {
    while [ -z "$FASTAF_KEYMAP" ] || [ -z "$FASTAF_LOCALE" ]; do
        dialog --title "Locale & Keyword Layout" \
            --msgbox "Welcome to Fast-AF.\n\nYou must configure your system locale and keyboard layout before accessing the installer dashboard, to ensure correct text input." 12 60

        # 1) Keyboard layout selection
        FASTAF_KEYMAP=$(dialog --title "Keyboard Layout" \
            --menu "Select your primary keyboard layout:" 14 50 5 \
            "us" "US QWERTY" \
            "uk" "UK QWERTY" \
            "de" "German (DE)" \
            "fr" "French (FR)" \
            "other" "--- Show Full List of All Keymaps ---")
        [ $? -ne 0 ] && continue

        # Load massive dynamic keymap list if they picked other
        if [ "$FASTAF_KEYMAP" = "other" ]; then
            local keymaps=()
            while read -r map; do
                [ -n "$map" ] && keymaps+=("$map" "")
            done < <(localectl list-keymaps)

            FASTAF_KEYMAP=$(dialog --title "All Available Keymaps" \
                --menu "Select from full system list:" 20 60 12 "${keymaps[@]}")
            [ $? -ne 0 ] && continue
        fi

        # 2) System Locale Selection
        FASTAF_LOCALE=$(dialog --title "System Locale" \
            --menu "Select your system locale:" 14 55 5 \
            "en_US.UTF-8" "English (US UTF-8)" \
            "en_GB.UTF-8" "English (UK UTF-8)" \
            "de_DE.UTF-8" "German (Germany UTF-8)" \
            "other" "--- Show Full List of All Locales ---")
        [ $? -ne 0 ] && continue

        # Load massive dynamic locale list
        if [ "$FASTAF_LOCALE" = "other" ]; then
            local locales=()
            while read -r loc; do
                [ -n "$loc" ] && locales+=("$loc" "")
            done < <(localectl list-locales)

            FASTAF_LOCALE=$(dialog --title "All Available Locales" \
                --menu "Select from full system list:" 20 60 12 "${locales[@]}")
            [ $? -ne 0 ] && continue
        fi

        # Apply the keymap immediately to current live session environment
        # Idk how to do this or if the mapped outputs will be correct, so for now I'm going to log it and see what the values are
        log_info "$FASTAF_KEYMAP"
    done
}

# ==================================================
# ==========         GUI FUNCTIONS        ==========
# ==================================================

configure_network() {
    command -v nmtui &>/dev/null || fatal_error "NetworkManager / nmtui is missing from this environment."
    clear
    nmtui
    log_info "Network Manager configured the network. #This should use nmcli connections to show the new active connects if any?"
}

configure_drive() {
    local disks=()
    while read -r name size model; do
        disks+=("$name" "$size - $model")
    done < <(lsblk -d -n -o NAME,SIZE,MODEL | grep -v "loop" | grep -v "sr")

    if [ ${#disks[@]} -eq 0 ]; then
        dialog --title "Error" --msgbox "No valid block devices detected!" 10 40
        return
    fi

    local selected
    selected=$(dialog --title "Target Drive Selection" \
        --menu "WARNING: The selected drive will be completely WIPED and formatted!\n\nChoose destination drive for Fast-AF:" 17 65 5 "${disks[@]}")

    if [ $? -eq 0 ] && [ -n "$selected" ]; then
        if (dialog --title "DESTRUCTIVE CHOICE WARNING" --yesno "Are you absolutely sure you want to select /dev/$selected? All data on this disk will be permanently lost after install." 10 60); then
            FASTAF_TARGET_DRIVE="$selected"
            log_info "Target drive selected: /dev/$FASTAF_TARGET_DRIVE"
        fi
    fi
}

configure_identity() {
    local output
    # dialog --form syntax: text height width formheight \
    # [label] [label_y] [label_x] [item] [item_y] [item_x] [field_len] [input_len]
    output=$(dialog --title "Identity & Credentials Setup" \
        --mixedform "Configure your system identifiers and account passwords:" 16 65 4 \
        "Hostname:"      1 1 "$FASTAF_HOSTNAME"      1 18 25 30 0 \
        "Root Password:" 2 1 "$FASTAF_ROOT_PASSWORD" 2 18 25 30 1 \
        "Username:"      3 1 "$FASTAF_USER_NAME"     3 18 25 30 0 \
        "User Password:" 4 1 "$FASTAF_USER_PASSWORD" 4 18 25 30 1)
    [ $? -ne 0 ] && return

    # dialog --form returns each field separate by a newline
    mapfile -t fields <<< "$output"

    [ -n "${fields[0]}" ] && FASTAF_HOSTNAME="${fields[0]}"
    [ -n "${fields[1]}" ] && FASTAF_ROOT_PASSWORD="${fields[1]}"
    [ -n "${fields[2]}" ] && FASTAF_USER_NAME="${fields[2]}"
    [ -n "${fields[3]}" ] && FASTAF_USER_PASSWORD="${fields[3]}"

    log_info "Identity configured - Hostname: $FASTAF_HOSTNAME, User: $FASTAF_USER_NAME"
}

configure_security() {
    local enc_status="OFF"
    local enc_fido_status="OFF"
    local doas_fido_status="OFF"

    [ "$FASTAF_ENCRYPT" = true ] && enc_status="ON"
    [ "$FASTAF_ENCRYPT_FIDO" = true ] && enc_fido_status="ON"
    [ "$FASTAF_DOAS_FIDO" = true ] && doas_fido_status="ON"

    local result
    result=$(dialog --title "Security Options Dashboard" \
        --checklist "Use [Space] to toggle options, [Enter] to save:" 15 68 3 \
        "ENCRYPT" "Enable System Disk Encryption" "$enc_status" \
        "ENCRYPT_FIDO" "Bind FIDO2 Security Key to Disk" "$enc_fido_status" \
        "DOAS_FIDO" "Bind FIDO2 Security Key to doas" "$doas_fido_status")
    [ $? -ne 0 ] && return

    # Reset and parse selected items
    FASTAF_ENCRYPT=false
    FASTAF_ENCRYPT_FIDO=false
    FASTAF_DOAS_FIDO=false

    for item in $result; do
        case "$item" in
            '"ENCRYPT"') FASTAF_ENCRYPT=true ;;
            '"ENCRYPT_FIDO"') FASTAF_ENCRYPT_FIDO=true ;;
            '"DOAS_FIDO"') FASTAF_DOAS_FIDO=true ;;
        esac
    done

    # Enforce dependency validation: FIDO2 disk binding requires encryption enabled
    if [ "$FASTAF_ENCRYPT_FIDO" = true ] && [ "$FASTAF_ENCRYPT" != true ]; then
        dialog --title "Notice" --msgbox "System Disk Encryption must be enabled to bind FIDO2 to the disk. FIDO2 disk binding has been disabled." 10 50
        FASTAF_ENCRYPT_FIDO=false
    fi

    # Handle setting the password for the encrypted partition if user chose to have encryption
    if [ "$FASTAF_ENCRYPT" = true ] && [ -z "$FASTAF_ENCRYPT_PASSWORD" ]; then
        local enc_pass
        enc_pass=$(dialog --title "Disk Encryption Password" \
            --passwordbox "Enter LUKS Decryption passphrase for system disk:" 10 50)

        if [ $? -eq 0 ] && [ -n "$enc_pass" ]; then
            FASTAF_ENCRYPT_PASSWORD="$enc_pass"
        else
            dialog --title "Notice" --msgbox "Disk encryption requires a passphrase. Encryption has been disabled." 10 50
            FASTAF_ENCRYPT=false
            FASTAF_ENCRYPT_FIDO=false
        fi
    elif [ "$FASTAF_ENCRYPT" = false ]; then
        # Clear the password only if the user explicitly turned encryption off
        FASTAF_ENCRYPT_PASSWORD=""
        FASTAF_ENCRYPT_FIDO=false
    fi

    log_info "Security options configured - Encrypt: $FASTAF_ENCRYPT, Encrypt FIDO: $FASTAF_ENCRYPT_FIDO, doas FIDO: $FASTAF_DOAS_FIDO"
}

configure_dotfiles() {
    local new_repo
    new_repo=$(dialog --title "Configure Dotfiles" --inputbox "Enter your dotfiles Git URL:" 10 60 "$FASTAF_DOTFILES_REPO")
    [ -n "$new_repo" ] && FASTAF_DOTFILES_REPO="$new_repo"
    log_info "Dotfiles repo configured: $FASTAF_DOTFILES_REPO"
}

# ==================================================
# ==========     SECURE CONFIG EXPORT     ==========
# ==================================================

save_secure_config() {
    umask 077
    cat <<EOF > /run/fastaf-config.env
FASTAF_KEYMAP=$FASTAF_KEYMAP
FASTAF_LOCALE=$FASTAF_LOCALE
FASTAF_TARGET_DRIVE=$FASTAF_TARGET_DRIVE
FASTAF_HOSTNAME=$FASTAF_HOSTNAME
FASTAF_USER_NAME=$FASTAF_USER_NAME
FASTAF_USER_PASSWORD=$FASTAF_USER_PASSWORD
FASTAF_ROOT_PASSWORD=$FASTAF_ROOT_PASSWORD
# Dotfiles repo method is deprecated - going to make a meta package. This variable will just be renamed dotfiles package once we can setup for it
FASTAF_DOTFILES_REPO=$FASTAF_DOTFILES_REPO
FASTAF_ENCRYPT=$FASTAF_ENCRYPT
FASTAF_ENCRYPT_PASSWORD=$FASTAF_ENCRYPT_PASSWORD
FASTAF_ENCRYPT_FIDO=$FASTAF_ENCRYPT_FIDO
FASTAF_DOAS_FIDO=$FASTAF_DOAS_FIDO
EOF
    log_info "Secure configuration exported to /run/fastaf-config.env"
}

# ==================================================
# ==========   PRE-FLIGHT & VALIDATION    ==========
# ==================================================

verify_and_launch_install() {
    local errors=()

    # Validate chosen drive
    if [ -z "$FASTAF_TARGET_DRIVE" ]; then
        errors+=("- Target drive is not selected")
    elif [ ! -b "/dev/$FASTAF_TARGET_DRIVE" ]; then
        errors+=("- Selected target drive /dev/$FASTAF_TARGET_DRIVE is invalid or missing")
        # ADD ANOTHER ELIF TO CHECK FOR DRIVE SIZE TO MAKE SURE IT MEETS A MINIMUM
        # ANY OTHER DRIVE CHECKS? MAYBE IN ENGINE CHECK THE DRIVE HEALTH AND ONLY PROCEED IF HEALTHY?
    fi

    # Validate identitifiers and credentials
    # Need to valid host name make sure its input is valid for a hostname
    if [ -z "$FASTAF_ROOT_PASSWORD" ]; then
        errors+=("- Root password has not been set")
    fi
    # Need to validate user name make sure it's input is valid for a user name
    if [ -z "$FASTAF_USER_PASSWORD" ]; then
        errors+=("- User password has not been set")
    fi

    # Validate internet connection
    if ! ping -c 1 1.1.1.1 &>/dev/null && ! ping -c 1 archlinux.org &>/dev/null; then
        errors+=("- No active internet connection detected, please configure network via nmtui")
    fi

    # List errors if any
    if [ ${#errors[@]} -gt 0 ]; then
        local err_msg="The following checks failed and must be resolved before installation:\n\n"
        for err in "${errors[@]}"; do
            err_msg+="$err\n"
        done
        dialog --title "Pre-flight Checks Failed" --msgbox "$err_msg" 16 65
        log_info "Pre-flight checks failed ${errors[*]}"
        return
    fi

    local summary="Please review your final deployment configurations:\n\n"
    summary+="• Keymap / Locale : $FASTAF_KEYMAP / $FASTAF_LOCALE\n"
    summary+="• Target Drive : $FASTAF_TARGET_DRIVE\n"
    summary+="• Hostname : $FASTAF_HOSTNAME\n"
    summary+="• User Account : $FASTAF_USER_NAME\n"
    summary+="• Disk Encryption : $FASTAF_ENCRYPT (FIDO2 Key: $FASTAF_ENCRYPT_FIDO)\n"
    summary+="• doas Hardware Key : $FASTAF_DOAS_FIDO\n"
    summary+="• Dotfiles Repo : $FASTAF_DOTFILES_REPO\n\n"
    summary+="Proceed with deployment?"

    if (dialog --title "--- Final Confirmation ---" --yesno "$summary" 18 65); then
        save_secure_config
        run_installer_engine
    fi
}

# ==================================================
# ==========         RUN INSTALLER        ==========
# ==================================================

run_installer_engine() {
    clear

    if [ -f /run/fastaf-config.env ]; then
        # shellcheck disable=SC1091
        source /run/fastaf-config.env
        rm -f /run/fastaf-config.env
    else
        fatal_error "Secure configuration state file missing from /run!"
    fi

    log_info "Launching Fast-AF Deployment Engine..."

    echo "=========================================================================="
    echo " Fast-AF Deployment Started"
    echo " Username: $FASTAF_USER_NAME | Hostname: $FASTAF_HOSTNAME"
    echo " Target: /dev/$FASTAF_TARGET_DRIVE | Encryption: $FASTAF_ENCRYPT"
    echo " doas FIDO2: $FASTAF_DOAS_FIDO | FIDO2 Disk: $FASTAF_ENCRYPT_FIDO"
    echo " Dotfiles Repo: $FASTAF_DOTFILES_REPO"
    echo "=========================================================================="

    # Fake stuff
    echo "-> Initializing gizmos and whojamisntiin tables..."
    sleep 1

    echo "=========================================================================="
    echo " Fast-AF Deployment Completed"
    echo "=========================================================================="

    # add an automatic reboot, maybe checks to make sure it was successful and went as expected? But that's a lot of writing for rn
}

# ==================================================
# ==========       DASHBOARD LOGIC        ==========
# ==================================================

configure_gateway

while true; do
    CHOICE=$(dialog --title "Fast-AF Installer Dashboard" \
        --menu "Configure settings, then select 'Begin Installation':" 19 68 9 \
        "1" "Locality Settings [ Keymap: $FASTAF_KEYMAP | Locale: $FASTAF_LOCALE ]"\
        "2" "Network Setup     [ Network Manager TUI ]" \
        "3" "Identity Setup    [ Hostname: $FASTAF_HOSTNAME | User: $FASTAF_USER_NAME ]" \
        "4" "Target Drive      [ ${FASTAF_TARGET_DRIVE:-NOT SET} ]" \
        "5" "Security Options  [ Encryption: $FASTAF_ENCRYPT ]" \
        "6" "Dotfiles Repo     [ Configured ]" \
        "7" "Open Debugging Subshell" \
        "8" "BEGIN INSTALLATION")

    exitstatus=$?

    if [ $exitstatus -ne 0 ]; then
        continue
    fi

    case $CHOICE in
        1) configure_gateway ;;
        2) configure_network ;;
        3) configure_identity ;;
        4) configure_drive ;;
        5) configure_security ;;
        6) configure_dotfiles ;;
        7)
            clear
            echo "============================================================"
            echo " Entering interactive subshell. State is preserved."
            echo " Type 'exit' to return to the Fast-AF Installer dashboard."
            echo "============================================================"
            "$SHELL"
            continue ;;
        8)
            verify_and_launch_install ;;
    esac
done
